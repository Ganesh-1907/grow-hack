# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=5000

# GitHub (optional for public repositories, required for higher rate limits)
GITHUB_TOKEN=

# LLM provider: deepseek (default), openai, or groq
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Groq/OpenAI keys supported as fallbacks (any OpenAI-compatible endpoint).
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# Dev.to publishing (get key at https://dev.to/settings/extensions)
DEVTO_API_KEY=

# Generation
MAX_REPOSITORY_SIZE_MB=100
CLONE_TIMEOUT_SECONDS=120
ENABLE_MOCK_LLM=true
